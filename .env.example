# BrainHub local state root.
# Defaults to ~/.brainhub when unset.
# BRAINHUB_HOME=~/.brainhub

# Optional Obsidian vault path used only after an item is explicitly approved.
# BRAINHUB_OBSIDIAN_VAULT_PATH=~/Documents/ObsidianVault

# Compatibility fallback for hosts that already expose this variable.
# OBSIDIAN_VAULT_PATH=~/Documents/ObsidianVault
